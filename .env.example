# Optional HTTPS endpoint under your control. Leave empty for local-only assessment.
# Accept POST JSON (ConsultationPayload in src/lib/assessment.ts), enforce validation,
# rate limiting and consent server-side. Use server-side secrets for CRM/Supabase.
NEXT_PUBLIC_CONSULTATION_ENDPOINT=

# Optional VSL source: HTTPS YouTube/Vimeo watch URL or direct .mp4/.webm URL.
# Leave empty until a real video is supplied; the page displays a labeled poster.
NEXT_PUBLIC_VSL_URL=

# Optional WebVTT captions for a direct video source.
NEXT_PUBLIC_VSL_CAPTIONS_URL=
